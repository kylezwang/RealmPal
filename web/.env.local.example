# Copy to .env.local | Next.js reads this automatically
NEXT_PUBLIC_API_URL=http://localhost:8000
API_URL=http://localhost:8000

# Entra External ID (CIAM). All public identifiers, never secrets - a SPA
# has no client secret (PKCE instead). Same values as the root .env's
# ENTRA_TENANT_ID / ENTRA_WEB_CLIENT_ID / ENTRA_USER_FLOW / AUTH_AUDIENCE,
# just re-exposed here under NEXT_PUBLIC_ so the browser bundle can read
# them (see docs/DEPLOYMENT_GUIDE.md PRIORITY 3). Leave unset to keep
# "Continue with Microsoft" showing its old "not set up yet" message
# instead of attempting a real Entra redirect.
NEXT_PUBLIC_ENTRA_TENANT_ID=
NEXT_PUBLIC_ENTRA_WEB_CLIENT_ID=
NEXT_PUBLIC_ENTRA_USER_FLOW=sign-up-sign-in
# api://<ENTRA_API_CLIENT_ID>/access_as_user
NEXT_PUBLIC_ENTRA_API_SCOPE=
