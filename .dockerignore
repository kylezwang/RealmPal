# Build context is the repo root (see api/Dockerfile), but the image only
# ever needs api/. Everything else here just slows down `docker build`
# sending the context to the daemon, or leaks secrets/dev state into it.
.git
.github
.cursor
.pytest_cache
web
docs
*.md
.env
.env.*
!.env.example
data/
*.db
*.db-wal
*.db-shm
__pycache__
**/__pycache__
*.pyc
