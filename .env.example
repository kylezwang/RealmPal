# ==========================================
# Realm Pal - Environment Variables
# Copy this to .env and fill in real values.
# NEVER commit .env to version control.
# ==========================================

# --- Required (one of: Foundry, or a direct Anthropic key for local fallback) ---
# Local: a direct Anthropic key until the Foundry resource exists.
ANTHROPIC_API_KEY=sk-ant-...
# This `dev` branch defaults PREFER_ANTHROPIC=true so Foundry vars in .env
# do not take over. Master is Foundry-first (PREFER_ANTHROPIC=false).
# PREFER_ANTHROPIC=true

# Production: Microsoft Foundry Anthropic surface. Prefer Entra so neither
# an Anthropic key nor a Foundry key lives in the environment.
# Resource *or* full base URL, never both. Path must be /anthropic — not
# the OpenAI-shaped /openai/deployments/... path.
# FOUNDRY_RESOURCE=your-foundry-resource
# FOUNDRY_BASE_URL=https://your-foundry-resource.services.ai.azure.com/anthropic
# FOUNDRY_USE_ENTRA=true
# Local Foundry without managed identity: a Foundry API key instead of Entra.
# FOUNDRY_API_KEY=
# CLAUDE_MODEL=claude-sonnet-4-6
# CLAUDE_LIGHT_MODEL=claude-haiku-4-5
# CCU list price is $0.01 (100 CCU = $1). Token rates below are unchanged.
# FOUNDRY_CCU_USD=0.01

# JWT secret - generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-random-64-char-hex

# Separate secret for magic links. Falls back to JWT_SECRET when unset, but
# then a leaked link (email logs, a referrer header) also forges a session -
# set this explicitly with its own random value.
MAGIC_LINK_SECRET=
MAGIC_LINK_TTL_MINUTES=30

# --- Identity provider (optional locally; required in any deployment) ---
# Any provider that publishes a JWKS endpoint works. Leave blank to run
# anonymously in local dev. Asymmetric algorithms only.
#
# Entra External ID:
#   AUTH_JWKS_URL=https://<tenant>.ciamlogin.com/<tenant-id>/discovery/v2.0/keys
#   AUTH_ISSUER=https://<tenant-id>.ciamlogin.com/<tenant-id>/v2.0
#   AUTH_AUDIENCE=<application-client-id>
# Supabase Auth:
#   AUTH_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
#   AUTH_ISSUER=https://<project-ref>.supabase.co/auth/v1
#   AUTH_AUDIENCE=authenticated
AUTH_PROVIDER=
AUTH_JWKS_URL=
AUTH_ISSUER=
AUTH_AUDIENCE=
AUTH_ALGORITHMS=RS256,ES256
AUTH_JWKS_CACHE_SECONDS=600

# --- Quotas and abuse limits ---
# Signed-in callers are counted against their verified account; anonymous
# ones against their IP, with a smaller allowance.
FREE_MESSAGE_LIMIT=5
ANONYMOUS_MESSAGE_LIMIT=3
# Keys the hashes used for quota buckets, so raw IPs never reach Redis.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
PII_HASH_SECRET=
# Enable ONLY behind a proxy you control, and set the hop count to match.
# X-Forwarded-For is caller-supplied, so trusting it otherwise lets anyone
# reset their own rate limit. Always start uvicorn with --no-proxy-headers.
TRUST_FORWARDED_FOR=false
FORWARDED_PROXY_HOPS=1
# Daily ceiling for paid accounts. Abuse fuse, not expected use.
PAID_MESSAGE_LIMIT=50

# Burst limit for players/items/dungeons/skins/sprite lookups. A cache miss
# on any of these launches a real headless browser (see api/services/
# scraper.py), so unlike chat this is a short window, not a daily cap.
LOOKUP_RATE_LIMIT_ANONYMOUS=12
LOOKUP_RATE_LIMIT_USER=40
LOOKUP_RATE_WINDOW_SECONDS=60

# Wiki / items / dungeons / skins: serve cache, refresh once a week
# (`python -m api.scripts.refresh_wiki`). Player lookups scrape on request;
# the short TTL only collapses sidebar + chat hitting RealmEye twice.
WIKI_SCRAPE_TTL_HOURS=168
PLAYER_SCRAPE_TTL_SECONDS=120

# --- Cost ceilings ---
# Per-identity quotas stop one abuser, not a crowd. Once the day's recorded
# spend reaches 1/30th of this, chat returns 503 until tomorrow. Measured
# against real token counts after each response.
#
# At Sonnet pricing a typical message costs ~$0.013 (input dominates: the
# system prompt plus retrieved context is far larger than the answer), so
# $20/month works out to roughly 50 messages a day.
MONTHLY_COST_BUDGET_USD=20.0
# $7 includes this many Claude replies / month (~$2.50 at ~$0.0365/reply).
# Stored answers do not count. After that, on-demand is $0.08/reply
# up to the user's spend cap (default $0). Old default was 90.
PAID_CLAUDE_INCLUDED=68
CLAUDE_OVERAGE_USD=0.08
# Per million tokens. Foundry CCU is these rates converted at FOUNDRY_CCU_USD.
# Update alongside CLAUDE_MODEL.
MODEL_INPUT_COST_PER_MTOK_USD=3.0
MODEL_OUTPUT_COST_PER_MTOK_USD=15.0
MAX_RESPONSE_TOKENS=4096
ANTHROPIC_TIMEOUT_SECONDS=120
# Static off switch. To shut chat off without a redeploy, instead set the
# Redis key `killswitch:chat` to the message users should see.
CHAT_ENABLED=true

# --- Embeddings (pick one: "ollama" free/local, or "voyage" for prod) ---
EMBEDDING_BACKEND=ollama
VOYAGE_API_KEY=
OLLAMA_URL=http://localhost:11434

# --- Durable stores (accounts, entitlements, uploads, billing prefs) ---
# Empty: SQLite files under data/ (below). No infra dependency, what local
# dev and tests use. Set to a postgresql:// DSN in any deployment running
# more than one replica - SQLite on a shared volume is not safe with
# concurrent writers. Was "SQLite until billing lands, then Postgres" per
# BACKLOG.md; billing landed Sep 13, 2026.
#   DATABASE_URL=postgresql://user:password@host:5432/realmpal
DATABASE_URL=

# --- Stripe (required for the signed-in Pro upgrade) ---
# Test mode is fine locally. Create a $7/month recurring price in the
# Stripe Dashboard, then paste the price_... id. After Checkout, the app
# confirms via POST /payments/confirm — a webhook is only needed for
# cancel/refund while the API is publicly reachable.
STRIPE_SECRET_KEY=sk_test-...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...
# Durable subscription state (api/services/entitlements.py). Written by
# the webhook above, read by the chat path instead of trusting a paid JWT
# claim for its whole lifetime with no way to revoke it early.
ENTITLEMENTS_DB_PATH=data/entitlements.db
# Local email+password accounts. Separate from entitlements so a free
# registered user has no paid row, and a legacy Stripe customer can still
# have an entitlement without registering here.
ACCOUNTS_DB_PATH=data/accounts.db
# Chat image attachments. Recycled after UPLOAD_TTL_DAYS so the file
# cannot grow without bound. Training jobs should only read rows that
# opted in via Settings → Train on my data (default on).
UPLOADS_DB_PATH=data/uploads.db
UPLOAD_TTL_DAYS=7

# --- Infrastructure (override if not using docker-compose defaults) ---
QDRANT_URL=http://localhost:6333
# Only for Qdrant Cloud
QDRANT_API_KEY=
QDRANT_COLLECTION=realm_pal
REDIS_URL=redis://localhost:6379

# Scopes Redis keys and the Qdrant collection to one deployment, so several
# environments can share an instance without reading each other's caches or
# quota counters. Leave blank for a single-environment setup.
DEPLOYMENT_NAMESPACE=

# --- App URLs ---
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
# Comma-separated. Extra CORS origins on top of APP_URL, for a hosting/domain
# cutover (e.g. the *.azurestaticapps.net URL while realmpal.com's DNS/TLS is
# still propagating, or both the apex and www custom domains at once).
EXTRA_CORS_ORIGINS=

# --- Dev ---
DEBUG=true
# Comma-separated IGNs that skip chat + lookup quotas while DEBUG=true.
# Leave empty for normal free/paid testing.
DEBUG_UNLIMITED_IGNS=
