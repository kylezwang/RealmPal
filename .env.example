# ==========================================
# Realm Pal - Environment Variables
# Copy this to .env and fill in real values.
# NEVER commit .env to version control.
# ==========================================

# --- Required ---
# Your Anthropic API key
ANTHROPIC_API_KEY=sk-ant-...

# JWT secret - generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-random-64-char-hex

# --- Embeddings (pick one: "ollama" free/local, or "voyage" for prod) ---
EMBEDDING_BACKEND=ollama
VOYAGE_API_KEY=
OLLAMA_URL=http://localhost:11434

# --- Stripe (optional for MVP, required for paid tier) ---
STRIPE_SECRET_KEY=sk_test-...
STRIPE_WEBHOOK_SECRET=whsec_...
# Your $7/month recurring price ID
STRIPE_PRICE_ID=price_...

# --- Infrastructure (override if not using docker-compose defaults) ---
QDRANT_URL=http://localhost:6333
# Only for Qdrant Cloud
QDRANT_API_KEY=
REDIS_URL=redis://localhost:6379

# --- App URLs ---
APP_URL=http://localhost:3000
API_URL=http://localhost:8000

# --- Dev ---
DEBUG=true
