# ==========================================
# Realm Pal - Environment Variables
# Copy this to .env and fill in real values.
# NEVER commit .env to version control.
# ==========================================

# --- Required ---
# Your Anthropic API key
ANTHROPIC_API_KEY=sk-ant-...

# JWT secret - generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-random-64-char-hex

# --- Identity provider (optional locally; required in any deployment) ---
# Any provider that publishes a JWKS endpoint works. Leave blank to run
# anonymously in local dev. Asymmetric algorithms only.
#
# Entra External ID:
#   AUTH_JWKS_URL=https://<tenant>.ciamlogin.com/<tenant-id>/discovery/v2.0/keys
#   AUTH_ISSUER=https://<tenant-id>.ciamlogin.com/<tenant-id>/v2.0
#   AUTH_AUDIENCE=<application-client-id>
# Supabase Auth:
#   AUTH_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
#   AUTH_ISSUER=https://<project-ref>.supabase.co/auth/v1
#   AUTH_AUDIENCE=authenticated
AUTH_PROVIDER=
AUTH_JWKS_URL=
AUTH_ISSUER=
AUTH_AUDIENCE=
AUTH_ALGORITHMS=RS256,ES256
AUTH_JWKS_CACHE_SECONDS=600

# --- Quotas and abuse limits ---
# Signed-in callers are counted against their verified account; anonymous
# ones against their IP, with a smaller allowance.
FREE_MESSAGE_LIMIT=10
ANONYMOUS_MESSAGE_LIMIT=3
# Keys the hashes used for quota buckets, so raw IPs never reach Redis.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
PII_HASH_SECRET=
# Enable ONLY behind a proxy you control, and set the hop count to match.
# X-Forwarded-For is caller-supplied, so trusting it otherwise lets anyone
# reset their own rate limit. Always start uvicorn with --no-proxy-headers.
TRUST_FORWARDED_FOR=false
FORWARDED_PROXY_HOPS=1

# --- Embeddings (pick one: "ollama" free/local, or "voyage" for prod) ---
EMBEDDING_BACKEND=ollama
VOYAGE_API_KEY=
OLLAMA_URL=http://localhost:11434

# --- Stripe (optional for MVP, required for paid tier) ---
STRIPE_SECRET_KEY=sk_test-...
STRIPE_WEBHOOK_SECRET=whsec_...
# Your $7/month recurring price ID
STRIPE_PRICE_ID=price_...

# --- Infrastructure (override if not using docker-compose defaults) ---
QDRANT_URL=http://localhost:6333
# Only for Qdrant Cloud
QDRANT_API_KEY=
QDRANT_COLLECTION=realm_pal
REDIS_URL=redis://localhost:6379

# Scopes Redis keys and the Qdrant collection to one deployment, so several
# environments can share an instance without reading each other's caches or
# quota counters. Leave blank for a single-environment setup.
DEPLOYMENT_NAMESPACE=

# --- App URLs ---
APP_URL=http://localhost:3000
API_URL=http://localhost:8000

# --- Dev ---
DEBUG=true
